{
  "title": "Stress Test Database Rumah Sakit",
  "uid": "stress-test-rs",
  "description": "Pemantauan stress test PostgreSQL: beban pgbench, metrik database (postgres_exporter), dan server (node_exporter).",
  "tags": [
    "postgresql",
    "stress-test",
    "pgbench"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "name": "Fase stress test",
        "target": {
          "type": "tags",
          "tags": [
            "stress-test"
          ],
          "matchAny": true,
          "limit": 200
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "datname",
        "label": "Database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(pg_stat_database_xact_commit, datname)",
          "refId": "datname"
        },
        "definition": "label_values(pg_stat_database_xact_commit, datname)",
        "current": {},
        "hide": 0,
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "node",
        "label": "Server DB (node_exporter)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(node_cpu_seconds_total, instance)",
          "refId": "node"
        },
        "definition": "label_values(node_cpu_seconds_total, instance)",
        "current": {},
        "hide": 0,
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Beban (pgbench)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "TPS pgbench",
      "description": "Transaksi per detik dari output pgbench -P (via textfile collector).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pgbench_tps",
          "legendFormat": "{{skenario}} · {{tahap}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latensi rata-rata pgbench",
      "description": "Latensi rata-rata transaksi dari output pgbench -P.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 200
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pgbench_latency_ms",
          "legendFormat": "{{skenario}} · {{tahap}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Transaksi gagal pgbench",
      "description": "Jumlah transaksi gagal per interval progress pgbench.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pgbench_failed",
          "legendFormat": "{{skenario}} · {{tahap}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Database (postgres_exporter)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Commit dan rollback per detik",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"$datname\"}[1m]))",
          "legendFormat": "commit/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pg_stat_database_xact_rollback{datname=\"$datname\"}[1m]))",
          "legendFormat": "rollback/s"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "Di bawah sekitar 99% berarti data tidak lagi muat di memori dan banyak dibaca dari disk.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "decimals": 2,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"$datname\"}[1m])) / (sum(rate(pg_stat_database_blks_hit{datname=\"$datname\"}[1m])) + sum(rate(pg_stat_database_blks_read{datname=\"$datname\"}[1m])))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Koneksi per status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (pg_stat_activity_count{datname=\"$datname\"})",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Lock per mode",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (pg_locks_count{datname=\"$datname\"})",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Deadlock (5 menit terakhir)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pg_stat_database_deadlocks{datname=\"$datname\"}[5m]))",
          "legendFormat": "deadlock"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Ukuran database",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_database_size_bytes{datname=\"$datname\"}",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Insert per detik (semua tabel)",
      "description": "Kecepatan insert, berguna saat fase seeding dan saat transaksi tulis.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_user_tables_n_tup_ins{datname=\"$datname\"}[1m]))",
          "legendFormat": "insert/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pg_stat_user_tables_n_tup_upd{datname=\"$datname\"}[1m]))",
          "legendFormat": "update/s"
        },
        {
          "refId": "C",
          "expr": "sum(rate(pg_stat_user_tables_n_tup_del{datname=\"$datname\"}[1m]))",
          "legendFormat": "delete/s"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Jumlah baris: 10 tabel terbesar",
      "description": "Bukti volume sample data per relasi.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, pg_stat_user_tables_n_live_tup{datname=\"$datname\"})",
          "legendFormat": "{{relname}}"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Dead tuples: 10 tabel teratas",
      "description": "Untuk soak test: bloat dan kinerja autovacuum.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, pg_stat_user_tables_n_dead_tup{datname=\"$datname\"})",
          "legendFormat": "{{relname}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Seq scan vs index scan per detik",
      "description": "Seq scan yang tinggi pada tabel besar menandakan index kurang (misalnya pada kolom FK).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_user_tables_seq_scan{datname=\"$datname\"}[1m]))",
          "legendFormat": "seq scan/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pg_stat_user_tables_idx_scan{datname=\"$datname\"}[1m]))",
          "legendFormat": "index scan/s"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Query terberat (pg_stat_statements)",
      "description": "Waktu eksekusi per detik untuk 10 query teratas. Butuh postgres_exporter dengan --collector.stat_statements. Cocokkan queryid dengan tabel pg_stat_statements.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, rate(pg_stat_statements_seconds_total{datname=\"$datname\"}[1m]))",
          "legendFormat": "{{queryid}}"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Server (node_exporter)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "CPU terpakai dan iowait",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{instance=\"$node\", mode=\"idle\"}[1m]))",
          "legendFormat": "CPU terpakai"
        },
        {
          "refId": "B",
          "expr": "avg(rate(node_cpu_seconds_total{instance=\"$node\", mode=\"iowait\"}[1m]))",
          "legendFormat": "iowait"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Disk sibuk",
      "description": "Mendekati 100% berarti disk menjadi bottleneck.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_io_time_seconds_total{instance=\"$node\", device!~\"loop.*|ram.*\"}[1m])",
          "legendFormat": "{{device}}"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Throughput disk",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(node_disk_read_bytes_total{instance=\"$node\", device!~\"loop.*|ram.*\"}[1m]))",
          "legendFormat": "baca"
        },
        {
          "refId": "B",
          "expr": "sum(rate(node_disk_written_bytes_total{instance=\"$node\", device!~\"loop.*|ram.*\"}[1m]))",
          "legendFormat": "tulis"
        }
      ]
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Memori",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 51
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "lineWidth": 2,
